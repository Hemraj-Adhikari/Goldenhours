# Copy this file to .env, then fill in the values from your Firebase project
# (Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup and config).
# .env is already git-ignored so your real keys never get committed.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
